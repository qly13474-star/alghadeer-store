{
  "name": "alghadeer-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cap:add": "npx cap add android",
    "cap:assets": "npx capacitor-assets generate --android",
